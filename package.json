{
  "name": "inspector-byor-scanner",
  "version": "0.0.0",
  "license": "MIT-0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "nx run-many --target=build --output-style=stream --nx-bail",
    "test": "nx run-many --target=test --output-style=stream --nx-bail",
    "lint": "nx run-many --target=lint --output-style=stream --nx-bail",
    "graph": "nx graph",
    "clean": "rm -rf packages/*/dist packages/*/cdk.out packages/*/.aws-sam packages/*/tsconfig.tsbuildinfo coverage reports && nx reset"
  },
  "devDependencies": {
    "@nx/eslint": "23.1.3",
    "@nx/eslint-plugin": "23.1.3",
    "@nx/js": "23.1.3",
    "@nxlv/python": "^23.0.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "nx": "23.1.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "5.0.9"
  }
}
