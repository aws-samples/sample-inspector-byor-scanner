{
  "name": "@inspector-byor-scanner/canary",
  "version": "0.0.0",
  "private": true,
  "license": "MIT-0",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:local": "node esbuild.config.mjs && cp -r sam/local-shims/* dist/nodejs/node_modules/",
    "sam:invoke": "npm run build:local && cd sam && sam build && sam local invoke -e event.json"
  },
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "inputs": ["production", "^production"],
        "outputs": ["{projectRoot}/dist"]
      },
      "sam:invoke": {
        "cache": false,
        "dependsOn": ["build"]
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws/synthetics-logger": "^16.0.0",
    "@aws/synthetics-puppeteer": "^16.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
