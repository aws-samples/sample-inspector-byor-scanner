{
  "name": "@inspector-byor-scanner/infra",
  "version": "0.0.0",
  "private": true,
  "license": "MIT-0",
  "scripts": {
    "test": "jest",
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy --all --require-approval never",
    "diff": "cdk diff",
    "destroy": "cdk destroy --all --force",
    "bootstrap": "cdk bootstrap"
  },
  "nx": {
    "implicitDependencies": [
      "@inspector-byor-scanner/canary",
      "scanner"
    ],
    "targets": {
      "synth": {
        "cache": true,
        "dependsOn": [
          "typecheck",
          "^build",
          {
            "projects": [
              "scanner"
            ],
            "target": "package"
          }
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/cdk.out"
        ]
      },
      "test": {
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{workspaceRoot}/coverage/packages/infra"
        ]
      },
      "deploy": {
        "cache": false,
        "dependsOn": [
          "synth"
        ]
      },
      "diff": {
        "cache": false,
        "dependsOn": [
          "typecheck",
          "^build",
          {
            "projects": [
              "scanner"
            ],
            "target": "package"
          }
        ]
      },
      "destroy": {
        "cache": false
      },
      "bootstrap": {
        "cache": false
      }
    }
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-python-alpha": "^2.258.1-alpha.0",
    "@aws-sdk/client-secrets-manager": "^3.1079.0",
    "@peculiar/x509": "^2.0.0",
    "aws-cdk-lib": "^2.262.0",
    "cdk-nag": "^3.0.1",
    "constructs": "^10.7.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "aws-cdk": "^2.1133.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
